# Apollo Health Guardian — API environment variables
# Copy this file to `.env` for local development.
# NEVER commit a real `.env` file with real values.
# On Cloud Run, set these with Secret Manager (see GUIA-DESPLIEGUE-CLOUD-RUN.md).

# Port the API listens on. Cloud Run injects $PORT automatically.
PORT=3001

# PostgreSQL connection string (Prisma format).
# Local example (docker-compose): postgresql://apollo:CHANGE_ME@localhost:5432/apollo_health?schema=public
# Neon / Supabase: paste the connection string they give you (it already includes sslmode).
DATABASE_URL=postgresql://apollo:CHANGE_ME@localhost:5432/apollo_health?schema=public

# Secret used to sign JWT tokens. Generate a long random one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER reuse the same secret across projects and NEVER commit it.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# How long a login token lasts.
JWT_EXPIRES_IN=7d
