# Apollo Health Guardian — API environment variables (Cloudflare Workers)
# For local dev, copy this file to `.dev.vars` in this same folder
# (wrangler reads it automatically with `wrangler dev`).
# NEVER commit a real `.dev.vars` file with real values.
# For the deployed Worker, set secrets with:
#   wrangler secret put DATABASE_URL
#   wrangler secret put JWT_SECRET

# PostgreSQL connection string (Neon, pooled host).
# Get the current one from the Neon dashboard (it has the current password).
# It must start with postgresql:// and include ?sslmode=require
# (Neon already includes it in the string it gives you).
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-floral-scene-bbhb99gh-pooler.c-15.us-east-1.aws.neon.tech/neondb?sslmode=require

# Secret used to sign JWT tokens. Generate a long random one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER reuse the same secret across projects and NEVER commit it.
# It must be a NEW secret, different from any secret ever committed to git.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# How long a login token lasts.
JWT_EXPIRES_IN=7d

# Origins allowed to call the API from a browser (comma-separated).
# The demo page served by this same Worker needs NO entry here (same origin).
# Add an entry only if the demo (or another page) calls the API from a
# different origin, e.g. the published demo page at https://muse.ai:
#   CORS_ORIGIN=https://muse.ai
# Leave it empty to block all cross-origin browser calls (safest default).
CORS_ORIGIN=
